# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Integração com o app Pelada Fácil Sorteio (Firebase), onde os jogadores votam nos sábados.
# Opcional: sem estas três, a Gestão funciona como antes (pedidos marcados à mão).
# Os dois primeiros vêm do .env do Sorteio (VITE_FIREBASE_PROJECT_ID / VITE_FIREBASE_API_KEY).
VITE_SORTEIO_PROJECT_ID=seu-projeto-firebase
VITE_SORTEIO_API_KEY=sua-api-key-firebase
# id da pelada no Sorteio (Painel admin > Config > copiar ID)
VITE_SORTEIO_PELADA_ID=id-da-pelada
